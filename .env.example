# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server
PORT="8787"
HOST="127.0.0.1"
DATABASE_PATH="data/news.sqlite"
HABR_AI_NEWS_RSS_URL="https://habr.com/ru/rss/hubs/artificial_intelligence/news/?fl=ru"

# ProxyAPI / OpenAI-compatible server
OPENAI_API_KEY="YOUR_PROXYAPI_KEY"
OPENAI_BASE_URL="https://openai.api.proxyapi.ru/v1"
OPENAI_MODEL="YOUR_MODEL"
OPENAI_TIMEOUT_MS="45000"

# Frontend development proxy target.
VITE_API_PROXY_TARGET="http://127.0.0.1:8787"

# Registry used only while building the Docker image.
NPM_REGISTRY="https://registry.npmmirror.com"
